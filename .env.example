# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# --- GoDaddy API credentials -----------------------------------------------
# Provisioned at developer.godaddy.com -> API Keys.
# Start with OTE (sandbox). Switch to production keys only when ready to go live.
GODADDY_API_KEY=your_key_here
GODADDY_API_SECRET=your_secret_here

# The account's customer UUID. Extract via:
#   1. Log into godaddy.com in Chrome.
#   2. DevTools -> Application -> Cookies -> godaddy.com -> auth_idp cookie.
#   3. Copy cookie value, paste into jwt.io, read the `cid` field.
GODADDY_CUSTOMER_ID=your_customer_uuid_here

# 'ote' or 'production'. Default 'ote' for safety.
GODADDY_ENV=ote

# --- API auth ----------------------------------------------------------------
# Shared bearer token the dashboard must send on every /api request.
# Generate: openssl rand -hex 32
# Production (Fly): fly secrets set API_AUTH_TOKEN=<value>
# Empty = auth disabled in OTE/dev, but FAIL-CLOSED (503) in production.
API_AUTH_TOKEN=

# --- Database / cache ------------------------------------------------------
# Local development:
DATABASE_URL=postgresql+asyncpg://snipe:snipe@localhost:5432/snipe
REDIS_URL=redis://localhost:6379/0

# --- App -------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Worker tuning ---------------------------------------------------------
WATCHLIST_REFRESH_INTERVAL_MINUTES=15
TRIGGER_LOOP_INTERVAL_SECONDS=1

# --- Optional integrations --------------------------------------------------
ESTIBOT_API_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
OUTBID_ALERT_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OUTBID_ALERT_SMS_TO=
